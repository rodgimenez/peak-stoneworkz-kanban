# Only needed for LOCAL development. The deployed site loads its Firebase config automatically.
# Copy to .env.local and either set VITE_USE_EMULATORS=true (no Firebase project needed),
# or fill these in from Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: only allow sign-ups with this email domain (e.g. peakstoneworkz.com)
VITE_ALLOWED_DOMAIN=

# Set to true to use the local Firebase emulators (npm run emulators)
VITE_USE_EMULATORS=false
